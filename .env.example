# All services remain loopback-only. Non-local URLs are rejected by the app.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
ANONYMIZED_TELEMETRY=false
JOB_AGENT_DASHBOARD_HOST=127.0.0.1
JOB_AGENT_DASHBOARD_PORT=7860

# Optional external AI providers for GUI-assisted users. Local Ollama remains
# the default. API keys are read from environment only; never commit .env.
JOB_AGENT_LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Actual web search is brokered through a local-only SearXNG instance.
# Never point this at a public URL.
JOB_AGENT_WEB_SEARCH_PROVIDER=searxng
JOB_AGENT_SEARXNG_URL=http://127.0.0.1:8099
JOB_AGENT_SEARXNG_PORT=8099

# Read-only job detail fetching is restricted to known public ATS/job hosts.
JOB_AGENT_ALLOWED_HOSTS=html.duckduckgo.com,duckduckgo.com,www.google.com,google.com,jobs.lever.co,boards.greenhouse.io,job-boards.greenhouse.io,job-boards.eu.greenhouse.io,boards.eu.greenhouse.io,careers.smartrecruiters.com,jobs.ashbyhq.com,jobs.workable.com,apply.workable.com,www.arbeitnow.com,arbeitnow.com,remoteok.com,remotive.com

# Optional SMTP sending. Do not fill these unless you explicitly choose to send.
# The app always requires typed SEND UPDATE confirmation even when configured.
# Supply an SMTP app password/token only; never store a primary email password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Optional Telegram status notifications. Prefer data/profiles/telegram.json
# for a local private setup; these env vars are also supported.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_WORKER_RUN=false

# Optional WhatsApp Cloud API status notifications. Prefer
# data/profiles/whatsapp.json for a local private setup; these env vars are also
# supported. This app only sends outbound notifications and does not expose a
# webhook publicly.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_NOTIFY_ON_WORKER_RUN=false
WHATSAPP_SEND_MODE=text
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
