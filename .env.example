# All services remain loopback-only. Non-local URLs are rejected by the app.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
ANONYMIZED_TELEMETRY=false
JOB_AGENT_DASHBOARD_HOST=127.0.0.1
JOB_AGENT_DASHBOARD_PORT=7860

# Read-only searches are restricted to known public search/ATS hosts.
JOB_AGENT_ALLOWED_HOSTS=html.duckduckgo.com,duckduckgo.com,www.google.com,google.com,jobs.lever.co,boards.greenhouse.io,job-boards.greenhouse.io,careers.smartrecruiters.com

# Optional SMTP sending. Do not fill these unless you explicitly choose to send.
# The app always requires typed SEND UPDATE confirmation even when configured.
# Supply an SMTP app password/token only; never store a primary email password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
